# Quantum Edge Guard policy — copy to qeg.policy and edit.
# One key = value per line. # starts a comment.

# Minimum TLS version an endpoint may negotiate: 1.2 or 1.3
min_tls = 1.2

# If true, an endpoint that negotiates classical-only key exchange
# (no post-quantum hybrid) is a POLICY FAIL, not just a warning.
require_pqc = false

# Hosts the guard refuses to pass. Repeatable. Checks against a denied
# host stop before any connection is made.
# deny_host = legacy.example.com
# deny_host = 203.0.113.10
